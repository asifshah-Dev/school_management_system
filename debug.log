        SELECT sfc.student_class_id, sc.student_registration_id, sc.session_id, sc.class_id, sfc.fee_type_id, sfc.total_amount, sfc.due_date, sfc.remarks,
               s.name AS student_name, co.id AS course_id, co.title AS course_title, c.title AS class_title,
               GROUP_CONCAT(ft.title SEPARATOR ', ') AS fee_type_title
        FROM student_fee_card sfc
        JOIN student_class sc ON sfc.student_class_id = sc.id
        JOIN student_registration s ON sc.student_registration_id = s.id
        JOIN classes c ON sc.class_id = c.id
        JOIN courses co ON c.course_id = co.id
        JOIN fee_types ft ON sfc.fee_type_id = ft.id
        WHERE sc.session_id = ? AND sc.class_id = ?
              AND (
                  (sfc.due_date != '0000-00-00' AND MONTH(sfc.due_date) = ? AND YEAR(sfc.due_date) = ?)
                  OR (sfc.due_date = '0000-00-00' AND sfc.remarks LIKE CONCAT('%', ?, ' ', ?))
              )
              AND ft.type = 'Monthly'
        GROUP BY sfc.student_class_id, sfc.due_date
        ORDER BY co.title, c.title, s.name
    
